{
  "topics": [
    {
      "name": "线条生命力与形体设计",
      "standard": "同一主体能设计三种不同形态，线条有轻重与疏密关系；清稿以后，原始动势仍然保留。"
    },
    {
      "name": "动作、视角与空间中的人物",
      "standard": "能在参考辅助下画出至少三种不同视角的人物，并独立设计具有明确动势和情绪的姿态。"
    },
    {
      "name": "视觉隐喻与意象表达",
      "standard": "给定一个抽象情绪，能够独立设计至少三种不同且具有可视化关系的表达方式，不再总是退回“漂亮人物加装饰”。"
    },
    {
      "name": "构图与视觉叙事",
      "standard": "同一概念能设计至少四种不同构图，并能解释为什么某种构图更适合表达特定情绪。"
    },
    {
      "name": "黑白、单色与色彩组织",
      "standard": "能从黑白底稿发展出至少两套有不同情绪的配色，并能控制明度、冷暖和饱和度，不再单靠叠加渐变解决画面平淡的问题。"
    },
    {
      "name": "Maud 方向的笔触与绘画性色彩",
      "standard": "不依赖整套完成的干净线稿，也能够绘制清楚、有体积、有色彩变化的形体；可以在绘画中自由地让线条与颜色相互调整。"
    },
    {
      "name": "人物、物品与环境的融合",
      "standard": "能设计包含多个对象的画面，并有意识地控制构图、人物与环境的关系、画面主次及色彩气氛。"
    },
    {
      "name": "原创系列与个人视觉语言",
      "standard": "至少能用相对一致的绘画语言表达两种不同情绪、两类不同题材，而不是依靠固定元素让作品看起来相似。"
    },
    {
      "name": "完整作品与微动态",
      "standard": "能独立完成从灵感、视觉隐喻、构图、造型、黑白、色彩到成品的流程，并能根据不同情绪选择合适的表现方式。"
    }
  ],
