# HTTPS origin, no trailing slash. Comma-separate additional trusted origins.
APP_ORIGINS=https://draw.example.com
COOKIE_SECURE=true
# First initialization only; stored in the database afterwards.
INIT_USERNAME=artist
IMAGE_TAG=0.3.0-beta.1
# Use a LAN IP only when the reverse proxy cannot reach host loopback.
BIND_ADDRESS=127.0.0.1
