# No .env file is required for the default Compose deployment.
# Optional server settings can be added under environment: in compose.yaml.
# INIT_USERNAME: artist        # First initialization only.
# APP_ORIGINS: https://draw.example.com  # Restrict to these exact origins.
# COOKIE_SECURE: auto          # auto (default), true, or false.
# Merely copying this file to .env does not pass settings to the container.
